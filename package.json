{
  "name": "zerolore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/data --noEmit && tsc -p apps/web --noEmit",
    "sim": "node --experimental-strip-types --no-warnings scripts/sim.ts",
    "sync": "node scripts/sync-web.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2"
  }
}
